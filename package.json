{
  "name": "inert-css",
  "version": "0.2.0",
  "type": "module",
  "description": "Finds CSS declarations that are present, valid, and can never take effect, by pairing a stylesheet with the class combinations that actually occur in your markup.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "SECURITY.md",
    "tests/corpus.test.mjs",
    "tests/fixture.test.mjs",
    "tests/real-defects.test.mjs",
    "demo/run-on-real-stylesheet.mjs",
    "tests/fixtures/globals.css",
    "tests/fixtures/corpus/dynamic-one.tsx",
    "tests/fixtures/corpus/dynamic-three.tsx",
    "tests/fixtures/corpus/one-class.tsx",
    "tests/fixtures/corpus/static-braced.tsx",
    "tests/fixtures/corpus/static-double.tsx",
    "tests/fixtures/corpus/static-single.tsx",
    "tests/fixtures/markup/button.tsx",
    "tests/fixtures/markup/dynamic.tsx",
    "tests/fixtures/markup/label.tsx",
    "tests/fixtures/markup/settings-row.tsx"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "css",
    "postcss",
    "static-analysis",
    "cascade",
    "lint"
  ],
  "author": "Justin Rhee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-rhee/inert-css.git"
  },
  "bugs": {
    "url": "https://github.com/justin-rhee/inert-css/issues"
  },
  "homepage": "https://github.com/justin-rhee/inert-css#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postcss": "^8.4.0"
  }
}
